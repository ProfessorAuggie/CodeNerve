# ───── CodeNerve Environment Variables ─────

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Get your URI from MongoDB Atlas: Database > Connect > Drivers > Node.js
# Example: mongodb+srv://admin:MyPassword123@cluster0.abcde.mongodb.net/codenerve?retryWrites=true&w=majority
MONGODB_URI=

# JWT Token Secret (Choose a strong random string)
JWT_SECRET=codenerve_super_secret_jwt_key_2026_change_in_production

# Google Sheets Webhook URL
# Generated from Google Apps Script (see google-apps-script/CodeNerveGoogleSheet.gs)
# Example: https://script.google.com/macros/s/AKfycbxXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/exec
GOOGLE_SHEET_WEBHOOK_URL=


